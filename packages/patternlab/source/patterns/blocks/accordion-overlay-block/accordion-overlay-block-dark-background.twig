{% set accordion_1_icon_list %}
  <p>At Penn State World Campus, we’re here to help you succeed in reaching your career goals — online, on your time.</p>
  {% set items = [
    { icon: 'fas-laptop', content: '<strong>Highly respected <a href="#">online degree programs</a></strong>' },
    { icon: 'fas-certificate', content: 'Earn the <strong><a href="#">same accredited Penn State degree</strong> or <strong>diploma</strong></a> online as students who attend Penn State on campus' },
    { icon: 'fa-clock', content: '<a href="#"><strong>Flexibility</strong></a> designed for today’s learners' },
    { icon: 'fas-family', content: 'Supports goals to <strong>balance family</strong> responsibilities, <a href="#"><strong>advance career</strong></a>, or <a href="#"><strong>return to education</strong></a>' },
  ] %}

  {% include '@oe/icon-list/icon-list.twig' with {
    columns: 2,
    column_width: 'narrow',
    items: items,
  } only %}
{% endset %}

{% set accordion_2_icon_list %}
  {% set items = [
    { icon: 'fas-chalkboard-user', content: 'Many courses <strong>taught by faculty</strong> who also <strong>teach in-person classes at Penn State</strong>' },
    { icon: 'fas-certificate', content: 'Penn State has more than 100 years of experience <a href="#"><strong>leading and innovating in distance education</strong></a>' },
    { icon: 'fas-graduation-cap', content: 'Benefit from the <strong>same <a href="#">academic rigor and faculty expertise</a></strong> as on-campus students' },
  ] %}

  {% include '@oe/icon-list/icon-list.twig' with {
    columns: 2,
    column_width: 'narrow',
    items: items,
  } only %}
{% endset %}

{% set accordion_3_icon_list %}
  {% set items = [
    { icon: 'fa-user-tie-hair-long-solid', content: 'Serving <strong>adult learners and working professionals</strong> with tools they need to succeed' },
    { icon: 'fas-briefcase', content: '<strong>Academic advising, career counseling</strong>, tech support, library tools, and mental health resources at your fingertips' },
    { icon: 'fas-comments', content: '<a href="#"><strong>Dedicated support services</strong></a> tailored to help online learners thrive' },
    { icon: 'fas-handshake-simple', content: 'Join a global network of more than 800,000 Penn State alumni, including more than <a href="#"><strong>40,000 World Campus alumni</strong></a>' },
  ] %}

  {% include '@oe/icon-list/icon-list.twig' with {
    columns: 2,
    column_width: 'narrow',
    items: items,
  } only %}
{% endset %}

{% set accordion_4_icon_list %}
  {% set items = [
    { icon: 'fa-calendar', content: '<h4 class="heading--xsmall heading--vspace-none"><a href="#">Multiple start dates</a> throughout the year</h4>Begin your journey when it works best for you' },
  ] %}

  {% include '@oe/icon-list/icon-list.twig' with {
    columns: 1,
    items: items,
  } only %}
{% endset %}

{% set accordion_5_icon_list %}
  {% set items = [
    { icon: 'fa-check-circle', content: '<h4 class="heading--xsmall heading--vspace-none">Backed by <a href="#">Penn State’s regional accreditation</a></h4>The Middle States Commission on Higher Education (MSCHE) maintains the highest standards.' },
  ] %}

  {% include '@oe/icon-list/icon-list.twig' with {
    columns: 1,
    items: items,
  } only %}
{% endset %}

{% set overlay_accordion_content %}
    {% include '@oe/accordion-group/accordion-group.twig' with {
      accordions: [
        {
          "id": "accordion-group-item-1",
          "heading_level": "h2",
          "heading_style": "medium",
          "label": "Why Choose Penn State World Campus?",
          "expandable_content": accordion_1_icon_list
        },
        {
          "id": "accordion-group-item-2",
          "heading_level": "h3",
          "label": "Online Courses Taught by Penn State Faculty",
          "expandable_content": accordion_2_icon_list
        },
        {
          "id": "accordion-group-item-3",
          "heading_level": "h3",
          "label": "Committed to Student Success",
          "expandable_content": accordion_3_icon_list
        },
        {
          "id": "accordion-group-item-4",
          "heading_level": "h3",
          "label": "Flexible Start Dates",
          "expandable_content": accordion_4_icon_list
        },
        {
          "id": "accordion-group-item-5",
          "heading_level": "h3",
          "label": "Trusted Accreditation",
          "expandable_content": accordion_5_icon_list
        },
      ],
      single_open: true,
    } only %}
{% endset %}

{% set overlay_accordion_image %}
  <picture class="responsive-image responsive-image--feature-banner">
    <source srcset="https://test.worldcampus.psu.edu/sites/default/files/2026-09/banner.jpg 1x" media="(min-width:800px)" type="image/webp" width="1920" height="840">
    <source srcset="https://test.worldcampus.psu.edu/sites/default/files/2026-09/banner.jpg 1x" type="image/webp" width="950" height="534">
    <img src="https://test.worldcampus.psu.edu/sites/default/files/2026-09/banner.jpg" width="3840" height="1200" alt="Snowy sidewalk at Penn State's University Park campus" loading="lazy">
  </picture>
{% endset %}
{% include '@oe/overlay/overlay.twig' with {
  image: overlay_accordion_image,
  content: overlay_accordion_content,
  overlay_bg_color: "blue-gradient",
  column_width: "normal",
  column_align: "left",
  overlay_width: "wide"
} %}